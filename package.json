{
  "name": "webstore-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.0.0",
  "scripts": {
    "postinstall": "prisma generate --schema=apps/web/prisma/schema.prisma",
    "build": "turbo run build",
    "deploy": "node scripts/deploy-ftp.js",
    "deploy:build": "node scripts/deploy-ftp.js --build",
    "deploy:backend": "node scripts/deploy-backend.js",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm --prefix apps/web run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "basic-ftp": "^6.2.3",
    "prisma": "^6.19.3",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
