{
  "name": "webstore-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm --prefix apps/web run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
