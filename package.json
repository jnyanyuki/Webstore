{
  "name": "webstore-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm --prefix apps/web run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "postcss": "^8.4.35",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "turbo": "^2.0.0",
    "typescript": "^5"
  }
}
