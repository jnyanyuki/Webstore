# ==============================================================================
# Webstore Backend Environment Configuration Example (Neon PostgreSQL & Storage)
# ==============================================================================

NODE_ENV=development
PORT=9000

# 1. Neon Serverless PostgreSQL Database Connections
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-royal-cake-b9cgphao.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-royal-cake-b9cgphao-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

DB_HOST=ep-royal-cake-b9cgphao-pooler.c-7.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_PASSWORD
DB_PGBOUNCER=true

# 2. Neon S3-Compatible Object Storage
AWS_ENDPOINT_URL_S3=https://br-bold-frog-b9vc8adt.storage.c-7.eu-central-1.aws.neon.tech
AWS_ACCESS_KEY_ID=generate_key_placeholder
AWS_SECRET_ACCESS_KEY=generate_key_placeholder
AWS_REGION=eu-central-1
S3_BUCKET=uploads

# 3. Neon Auth / Better Auth Configuration
NEON_AUTH_URL=https://ep-royal-cake-b9cgphao.neonauth.c-7.eu-central-1.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-royal-cake-b9cgphao.neonauth.c-7.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# 4. Redis Key-Value Store
REDIS_URL=redis://localhost:6379

# 5. Meilisearch Faceted Search Engine
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=03042c90cd9967c36e7c4b49882a7550

# 6. Safaricom M-Pesa Daraja Integration
DARARA_CONSUMER_KEY=your_daraja_consumer_key
DARARA_CONSUMER_SECRET=your_daraja_consumer_secret
DARARA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARARA_SHORTCODE=174379

# 7. Africa's Talking SMS Engine
AT_API_KEY=sandbox_key
AT_USERNAME=sandbox

# 8. Sentry Error Tracking
SENTRY_DSN=
