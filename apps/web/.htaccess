# ==============================================================================
# NovaHost Kenya cPanel Apache / LiteSpeed Configuration for juromart.com
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www.juromart.com to apex juromart.com
  RewriteCond %{HTTP_HOST} ^www\.juromart\.com$ [NC]
  RewriteRule ^(.*)$ https://juromart.com/$1 [L,R=301]

  # 3. Serve static public files directly if they exist
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ /public/$1 [L]

  # 4. Proxy to Node.js application port (if not using Phusion Passenger directly)
  RewriteRule ^$ http://127.0.0.1:3004/ [P,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:3004/$1 [P,L]
</IfModule>

# Security Headers for Apache
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
