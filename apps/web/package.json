{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "node -e \"try { require('child_process').execSync('prisma generate', {stdio:'inherit'}) } catch(e) { if (!require('fs').existsSync('../../node_modules/@prisma/client')) throw e; console.warn('Prisma client already active; skipping regeneration.') }\" && next build",
    "start": "next start -p 3004",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.8.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@webstore/api-client": "*",
    "@webstore/dynamic-attributes": "*",
    "@webstore/types": "*",
    "@webstore/ui": "*",
    "dotenv": "^16.4.7",
    "next": "16.4.0",
    "postcss": "^8.4.35",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ]
}
