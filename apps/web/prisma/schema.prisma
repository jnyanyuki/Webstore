datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Category {
  id           Int                        @id @default(autoincrement())
  name         String                     @db.VarChar(100)
  slug         String                     @unique @db.VarChar(120)
  displayOrder Int                        @default(0) @map("display_order")
  isActive     Boolean                    @default(true) @map("is_active")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  // Self-referencing parent/child hierarchy
  parentId     Int?                       @map("parent_id")
  parent       Category?                  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]                 @relation("CategoryHierarchy")

  // Relationships
  items        CategoryItem[]
  featured     CategoryFeaturedPromotion?
  products     CanonicalProduct[]

  @@index([parentId])
  @@map("categories")
}

model CategoryItem {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @map("category_id")
  title        String   @db.VarChar(100)
  slug         String   @db.VarChar(120)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_items")
}

model CategoryFeaturedPromotion {
  id         Int       @id @default(autoincrement())
  categoryId Int       @unique @map("category_id")
  title      String    @db.VarChar(150)
  subtitle   String?   @db.VarChar(255)
  imageUrl   String    @map("image_url") @db.Text
  targetUrl  String?   @map("target_url") @db.VarChar(255)
  isActive   Boolean   @default(true) @map("is_active")
  startAt    DateTime? @default(now()) @map("start_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_featured_promotions")
}

// Master Canonical Catalog Item (Golden Record anchored to GTIN / MPN)
model CanonicalProduct {
  id           Int              @id @default(autoincrement())
  categoryId   Int              @map("category_id")
  brand        String           @db.VarChar(100)
  title        String           @db.VarChar(255)
  slug         String           @unique @db.VarChar(280)
  description  String?          @db.Text
  specs        Json?            // Key-value attributes (e.g. {"RAM": "16GB", "Storage": "512GB"})
  images       Json?            // Array of ImageKit relative paths or external URLs
  gtin         String?          @unique @db.VarChar(14) // Universal barcode (UPC / EAN / GTIN)
  mpn          String?          @db.VarChar(100)        // Manufacturer Part Number
  basePrice    Float            @default(0) @map("base_price")
  originalPrice Float?          @map("original_price")
  badge        String?          @db.VarChar(50)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  listings     VendorListing[]
  alerts       UserProductAlert[]

  @@index([categoryId])
  @@index([gtin])
  @@index([brand])
  @@map("canonical_products")
}

model ProductVariant {
  id              Int              @id @default(autoincrement())
  productId       Int              @map("product_id")
  sku             String           @unique @db.VarChar(100)
  title           String           @db.VarChar(150)
  priceDelta      Float            @default(0) @map("price_delta")
  stockAvailable  Int              @default(10) @map("stock_available")
  attributes      Json?            // e.g. {"size": "XL", "color": "Black"}
  createdAt       DateTime         @default(now()) @map("created_at")

  product         CanonicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// Raw Ingestion Staging Table for supplier/distributor/Icecat delta feeds
model RawVendorProduct {
  id          Int       @id @default(autoincrement())
  sourceName  String    @map("source_name") @db.VarChar(50) // 'icecat', 'aliexpress', 'distributor_a', 'csv'
  externalId  String    @map("external_id") @db.VarChar(100)
  payload     Json
  gtin        String?   @db.VarChar(14)
  mpn         String?   @db.VarChar(100)
  isProcessed Boolean   @default(false) @map("is_processed")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([sourceName])
  @@index([gtin])
  @@index([isProcessed])
  @@map("raw_vendor_products")
}

// Processing queue for Phase 2 UPC/EAN barcode resolution
model BarcodeIngestQueue {
  gtin        String    @id @db.VarChar(14)
  sourceHint  String?   @map("source_hint") @db.VarChar(50) // 'wholesale_csv', 'fashion_vendor', 'manual'
  status      String    @default("PENDING") @db.VarChar(20) // 'PENDING', 'RESOLVED', 'NOT_FOUND', 'FAILED'
  attempts    Int       @default(0)
  lastAttempt DateTime? @map("last_attempt")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("barcode_ingest_queue")
}

// Phase 3: Multi-Vendor Synchronization & Inventory Management
model Vendor {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(150)
  code      String          @unique @db.VarChar(50) // e.g. 'KILIMALL_HUB', 'LOCAL_DIST_A'
  currency  String          @default("KES") @db.VarChar(3)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")

  listings  VendorListing[]

  @@map("vendors")
}

model VendorListing {
  id                 Int              @id @default(autoincrement())
  vendorId           Int              @map("vendor_id")
  canonicalProductId Int              @map("canonical_product_id")
  vendorSku          String           @map("vendor_sku") @db.VarChar(120)
  price              Float
  compareAtPrice     Float?           @map("compare_at_price")
  stockQuantity      Int              @default(0) @map("stock_quantity")
  lastSyncedAt       DateTime         @default(now()) @map("last_synced_at")

  vendor             Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([vendorId, canonicalProductId])
  @@unique([vendorId, vendorSku])
  @@index([canonicalProductId])
  @@index([canonicalProductId, price])
  @@map("vendor_listings")
}

// User price-drop and back-in-stock alert subscriptions
model UserProductAlert {
  id                  Int              @id @default(autoincrement())
  userId              Int              @map("user_id")
  canonicalProductId  Int              @map("canonical_product_id")
  targetPrice         Float?           @map("target_price")
  notifyOnBackInStock Boolean          @default(true) @map("notify_on_back_in_stock")
  lastNotifiedAt      DateTime?        @map("last_notified_at")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")

  canonicalProduct    CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalProductId])
  @@index([canonicalProductId])
  @@map("user_product_alerts")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique @db.VarChar(255)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  fullName     String?        @map("full_name") @db.VarChar(150)
  phone        String?        @db.VarChar(30)
  role         String         @default("CUSTOMER") @db.VarChar(30) // 'CUSTOMER', 'ADMIN', 'SELLER'
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  userId    String   @map("user_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}


