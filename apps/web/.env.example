# ==============================================================================
# JuroMart Frontend Web (Next.js 15) Environment Variables Template
# Copy this to .env.local for local dev, or add to Vercel Project Settings for production
# ==============================================================================

NODE_ENV=production

# 1. Canonical Site & Domain Routing
NEXT_PUBLIC_SITE_URL=https://juromart.com
NEXT_PUBLIC_STOREFRONT_URL=https://juromart.com
NEXT_PUBLIC_SELLER_URL=https://seller.juromart.com

# 2. Render Backend API Connectivity & SSR Reverse Proxy
NEXT_PUBLIC_API_URL=https://api.juromart.com
API_BASE_URL=https://api.juromart.com
BACKEND_INTERNAL_URL=https://api.juromart.com
INTERNAL_API_URL=https://api.juromart.com
NEXT_PUBLIC_WS_URL=wss://api.juromart.com/ws/notifications

# 3. Neon Serverless PostgreSQL Database Connections (Prisma ORM)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-royal-cake-b9cgphao-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-royal-cake-b9cgphao.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 4. Media & CDN Asset Optimization (ImageKit & Cloudinary)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/njndeveloper
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_OOuubdhc+1IxTZ/5za7fV2kB10M=
IMAGEKIT_PRIVATE_KEY=private_nhBtZ2qx9jIIcu2XcRkdSw+TAKs=
NEXT_PUBLIC_CDN_HOST=https://res.cloudinary.com/naicbd/image/upload
NEXT_PUBLIC_DEFAULT_IMAGE_QUALITY=85
NEXT_PUBLIC_ENABLE_HIGH_DPI=true

# 5. Cache & Revalidation
REVALIDATION_SECRET_TOKEN=naicbd_secret_nav_revalidation_token_99x
CACHE_NAV_TTL=86400
CACHE_CATALOG_TTL=3600

# 6. Observability
NEXT_PUBLIC_SENTRY_DSN=
