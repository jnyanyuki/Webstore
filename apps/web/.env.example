# ==============================================================================
# JuroMart Web (Next.js) Environment Configuration
# Production Domain: https://juromart.com | Hosted at NovaHost Kenya
# ==============================================================================

# 1. Canonical Site & API URLs
NEXT_PUBLIC_SITE_URL=https://juromart.com
NEXT_PUBLIC_API_URL=https://api.juromart.com
NEXT_PUBLIC_WS_URL=wss://juromart.com/ws/notifications

# 2. Server Internal Reverse Proxy (for Next.js Standalone SSR rewrites)
BACKEND_INTERNAL_URL=http://127.0.0.1:9000

# 3. PostgreSQL Database Connections (Neon / NovaHost DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 4. Media & CDN Asset Optimization
NEXT_PUBLIC_CDN_HOST=https://res.cloudinary.com/juromart/image/upload
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/njndeveloper
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_OOuubdhc+1IxTZ/5za7fV2kB10M=
IMAGEKIT_PRIVATE_KEY=private_nhBtZ2qx9jIIcu2XcRkdSw+TAKs=

# 5. Cache & Revalidation
REVALIDATION_SECRET_TOKEN=juromart_secret_nav_revalidation_token_99x
CACHE_NAV_TTL=86400
CACHE_CATALOG_TTL=3600

# 6. Error & Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=
